<Window x:Class="WiClip.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки WiClip"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">

        <TextBlock Text="Горячая клавиша" FontWeight="SemiBold"/>
        <TextBox x:Name="HotKeyBox" Style="{StaticResource SearchBox}" Margin="0,4,0,0"/>
        <TextBlock Text="Например: Ctrl+Shift+V, Alt+`, Win+Shift+C"
                   Foreground="{DynamicResource TextDimBrush}" FontSize="11" Margin="2,4,0,0"/>

        <TextBlock Text="Сколько записей хранить" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <TextBox x:Name="MaxItemsBox" Style="{StaticResource SearchBox}" Margin="0,4,0,0"/>

        <TextBlock Text="Оформление" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <ComboBox x:Name="ThemeBox" Margin="0,4,0,0" Padding="6,4">
            <ComboBoxItem Content="Как в системе" Tag="Auto"/>
            <ComboBoxItem Content="Светлое" Tag="Light"/>
            <ComboBoxItem Content="Тёмное" Tag="Dark"/>
        </ComboBox>

        <CheckBox x:Name="AutostartBox" Content="Запускать при входе в Windows" Margin="0,16,0,0"/>
        <CheckBox x:Name="PersistBox" Content="Сохранять историю между запусками"/>
        <CheckBox x:Name="ImagesBox" Content="Запоминать изображения"/>
        <CheckBox x:Name="PasteBox" Content="Сразу вставлять выбранное в активное окно"/>
        <CheckBox x:Name="SecretBox" Content="Не запоминать буфер менеджеров паролей"/>

        <TextBlock Text="Не запоминать копирование из процессов (через запятую)"
                   FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap"/>
        <TextBox x:Name="IgnoredBox" Style="{StaticResource SearchBox}" Margin="0,4,0,0"
                 TextWrapping="Wrap" AcceptsReturn="False"/>

        <TextBlock x:Name="ErrorText" Foreground="#FFE05252" Margin="0,12,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="DataFolderButton" Content="Папка с данными"
                    Style="{StaticResource FlatButton}" Click="DataFolderButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Padding="14,6" Margin="8,0,0,0"
                    Click="CancelButton_Click" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Сохранить" Padding="14,6" Margin="8,0,0,0"
                    Click="OkButton_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
