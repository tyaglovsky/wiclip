<Window x:Class="WiClip.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WiClip"
        Title="{x:Static local:Strings.SettingsTitle}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">

        <TextBlock Text="{x:Static local:Strings.LabelHotKey}" FontWeight="SemiBold"/>
        <TextBox x:Name="HotKeyBox" Style="{StaticResource SearchBox}" Margin="0,4,0,0"/>
        <TextBlock Text="{x:Static local:Strings.HintHotKey}"
                   Foreground="{DynamicResource TextDimBrush}" FontSize="11" Margin="2,4,0,0"/>

        <TextBlock Text="{x:Static local:Strings.LabelMaxItems}" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <TextBox x:Name="MaxItemsBox" Style="{StaticResource SearchBox}" Margin="0,4,0,0"/>

        <TextBlock Text="{x:Static local:Strings.LabelTheme}" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <ComboBox x:Name="ThemeBox" Margin="0,4,0,0" Padding="6,4">
            <ComboBoxItem Content="{x:Static local:Strings.ThemeAuto}" Tag="Auto"/>
            <ComboBoxItem Content="{x:Static local:Strings.ThemeLight}" Tag="Light"/>
            <ComboBoxItem Content="{x:Static local:Strings.ThemeDark}" Tag="Dark"/>
        </ComboBox>

        <TextBlock Text="{x:Static local:Strings.LabelLanguage}" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <ComboBox x:Name="LanguageBox" Margin="0,4,0,0" Padding="6,4">
            <ComboBoxItem Content="{x:Static local:Strings.LanguageAuto}" Tag="Auto"/>
            <ComboBoxItem Content="English" Tag="en"/>
            <ComboBoxItem Content="Русский" Tag="ru"/>
        </ComboBox>
        <TextBlock Text="{x:Static local:Strings.LanguageRestartNote}"
                   Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                   Margin="2,4,0,0" TextWrapping="Wrap"/>

        <CheckBox x:Name="AutostartBox" Content="{x:Static local:Strings.CheckAutostart}" Margin="0,16,0,0"/>
        <CheckBox x:Name="PersistBox" Content="{x:Static local:Strings.CheckPersist}"/>
        <CheckBox x:Name="ImagesBox" Content="{x:Static local:Strings.CheckImages}"/>
        <CheckBox x:Name="PasteBox" Content="{x:Static local:Strings.CheckPaste}"/>
        <CheckBox x:Name="SecretBox" Content="{x:Static local:Strings.CheckSecret}"/>

        <TextBlock Text="{x:Static local:Strings.LabelIgnored}"
                   FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap"/>
        <TextBox x:Name="IgnoredBox" Style="{StaticResource SearchBox}" Margin="0,4,0,0"
                 TextWrapping="Wrap" AcceptsReturn="False"/>

        <TextBlock x:Name="ErrorText" Foreground="#FFE05252" Margin="0,12,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="DataFolderButton" Content="{x:Static local:Strings.ButtonDataFolder}"
                    Style="{StaticResource FlatButton}" Click="DataFolderButton_Click"/>
            <Button x:Name="CancelButton" Content="{x:Static local:Strings.ButtonCancel}"
                    Padding="14,6" Margin="8,0,0,0" Click="CancelButton_Click" IsCancel="True"/>
            <Button x:Name="OkButton" Content="{x:Static local:Strings.ButtonSave}"
                    Padding="14,6" Margin="8,0,0,0" Click="OkButton_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
