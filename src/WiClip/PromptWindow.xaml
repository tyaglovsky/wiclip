<Window x:Class="WiClip.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WiClip"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display">

    <StackPanel Margin="18">
        <TextBlock x:Name="LabelText" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
        <TextBox x:Name="ValueBox" Style="{StaticResource SearchBox}" Margin="0,6,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static local:Strings.ButtonCancel}" Padding="14,6"
                    Click="CancelButton_Click" IsCancel="True"/>
            <Button Content="{x:Static local:Strings.ButtonSave}" Padding="14,6" Margin="8,0,0,0"
                    Click="OkButton_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
