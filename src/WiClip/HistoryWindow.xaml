<Window x:Class="WiClip.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WiClip"
        Title="WiClip"
        Width="460" Height="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <local:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <local:NotNullToCollapsedConverter x:Key="NotNullToCollapsed"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:IndexToBadgeConverter x:Key="IndexToBadge"/>
    </Window.Resources>

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush_}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" Margin="2,0,2,8">
                <TextBlock Text="Буфер обмена"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SettingsButton" Style="{StaticResource FlatButton}"
                            Content="⚙" FontSize="14" ToolTip="Настройки"
                            Click="SettingsButton_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource FlatButton}"
                            Content="✕" FontSize="13" ToolTip="Закрыть (Esc)"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Поиск -->
            <Grid Grid.Row="1">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource SearchBox}"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="SearchHint" Text="Поиск по истории…"
                           Foreground="{DynamicResource TextDimBrush}"
                           Margin="10,0,0,0" FontSize="14"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <!-- Список -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <ListBox x:Name="List"
                         Background="Transparent"
                         BorderThickness="0"
                         AlternationCount="1000"
                         ItemContainerStyle="{StaticResource ClipItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                         MouseDoubleClick="List_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Номер для Alt+1…9 -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                          Path=(ItemsControl.AlternationIndex),
                                                          Converter={StaticResource IndexToBadge}}"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           FontSize="11" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Preview}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Thumbnail, Converter={StaticResource NotNullToCollapsed}}"
                                               FontSize="13"/>
                                    <Image Source="{Binding Thumbnail}"
                                           Visibility="{Binding Thumbnail, Converter={StaticResource NullToCollapsed}}"
                                           MaxHeight="64" HorizontalAlignment="Left"
                                           Stretch="Uniform" Margin="0,2"/>
                                    <TextBlock Text="{Binding Meta}"
                                               Foreground="{DynamicResource TextDimBrush}"
                                               FontSize="11" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="📌"
                                           FontSize="12" VerticalAlignment="Top" Margin="6,0,0,0"
                                           Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyHint"
                           Text="Пока пусто. Скопируйте что-нибудь — запись появится здесь."
                           Foreground="{DynamicResource TextDimBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="20"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- Подсказки и уведомление о копировании -->
            <Grid Grid.Row="3" Margin="4,8,4,0">
                <TextBlock x:Name="HintText"
                           Foreground="{DynamicResource TextDimBrush}"
                           FontSize="11" TextWrapping="Wrap"
                           Text="Клик — скопировать · Двойной клик или Enter — вставить · Alt+1…9 — быстрый выбор · Ctrl+P — закрепить · Shift+Delete — удалить · Esc — закрыть"/>
                <TextBlock x:Name="ToastText"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
