<Window x:Class="WiClip.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WiClip"
        Width="520" Height="460"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static local:Strings.LabelName}" FontWeight="SemiBold"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Style="{StaticResource SearchBox}" Margin="0,4,0,0"/>
        <TextBlock Grid.Row="2" Text="{x:Static local:Strings.HintNameOptional}"
                   Foreground="{DynamicResource TextDimBrush}" FontSize="11" Margin="2,4,0,0"/>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{x:Static local:Strings.LabelFolder}" FontWeight="SemiBold"/>
            <ComboBox x:Name="FolderBox" Margin="0,4,0,0" Padding="6,4"
                      DisplayMemberPath="Name"/>
            <TextBlock Text="{x:Static local:Strings.LabelText}" FontWeight="SemiBold" Margin="0,14,0,0"/>
        </StackPanel>

        <TextBox x:Name="TextBox_" Grid.Row="4" Margin="0,4,0,0"
                 Style="{StaticResource TextArea}"/>

        <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="#FFE05252"
                   Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{x:Static local:Strings.ButtonCancel}" Padding="14,6"
                    Click="CancelButton_Click" IsCancel="True"/>
            <Button Content="{x:Static local:Strings.ButtonSave}" Padding="14,6" Margin="8,0,0,0"
                    Click="OkButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
